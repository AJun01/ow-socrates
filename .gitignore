# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual envs / package managers ---
.venv/
venv/
env/
.python-version

# --- uv ---
# uv.lock is checked in by design; ignore caches only
.uv-cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Models & large files (tracked separately via HF / git-lfs) ---
models/base/*
!models/base/.gitkeep
models/adapters/*
!models/adapters/.gitkeep
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# --- Data ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/training/*
!data/training/.gitkeep

# --- Experiment tracking ---
wandb/
mlruns/

# --- Outputs / logs ---
outputs/
logs/
*.log

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
